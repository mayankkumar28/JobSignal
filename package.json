{
  "name": "linkedin-hsm-extension",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "build:test": "webpack --mode development && node scripts/patch-test-manifest.js",
    "dev": "webpack --mode development --watch",
    "diagnose": "npm run build && node scripts/diagnose.mjs",
    "diagnose:fixture": "npm run build:test && node scripts/diagnose-fixture.mjs",
    "diagnose:live": "npm run build && node scripts/diagnose-live.mjs",
    "discover-selectors": "node scripts/discover-selectors.mjs",
    "discover-selectors:logged-in": "node scripts/discover-selectors.mjs --logged-in",
    "save-auth": "node scripts/save-auth.mjs",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --dir tests/integration",
    "test:e2e": "npm run build:test && npx playwright test --config tests/playwright-fixture.config.ts",
    "test:e2e:live": "npm run build:test && npx playwright test --config tests/playwright-live.config.ts",
    "test:perf": "vitest bench",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "update-snapshot": "node scripts/update-snapshot.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.1.42",
    "@types/jsdom": "^28.0.3",
    "@vitest/coverage-v8": "^4.1.6",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.4.0",
    "jsdom": "^29.1.1",
    "ts-loader": "^9.5.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6",
    "webpack": "^5.99.7",
    "webpack-cli": "^7.0.2"
  }
}
